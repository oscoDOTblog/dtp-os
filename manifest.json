{
  "name": "dtp-os",
  "description": "dtp-os \u2014 new tab home and browser tools",
  "version": "1.2.0",
  "manifest_version": 3,
  "icons": {
    "48": "assets/48.png",
    "128": "assets/128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "alarms",
    "downloads"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://xvbc38vi4h.execute-api.us-east-2.amazonaws.com/*",
    "https://*.amazonaws.com/*",
    "https://api.frankfurter.app/*",
    "*://*.twitch.tv/*",
    "https://api.github.com/*",
    "*://*.bandcamp.com/*",
    "*://*.bcbits.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/inject/bandcamp/init.js",
        "js/inject/bandcamp/modules/shared.js",
        "js/inject/bandcamp/modules/player.js",
        "js/inject/bandcamp/modules/overrides.js",
        "js/inject/bandcamp/modules/feed.js",
        "js/inject/bandcamp/modules/profile.js",
        "js/inject/bandcamp/modules/artist.js",
        "js/inject/bandcamp/modules/release.js",
        "js/inject/bandcamp/modules/bar.js",
        "js/inject/bandcamp/bandcamp-streamer.css"
      ],
      "matches": ["*://*.bandcamp.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "dtp-os",
    "default_icon": {
      "48": "assets/48.png",
      "128": "assets/128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "tab_override.html"
  }
}
